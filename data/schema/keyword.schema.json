{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legion-app.local/schema/keyword.schema.json",
  "title": "Legion Keyword Library",
  "type": "object",
  "required": ["_meta", "keywords"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["description", "rules_baseline", "last_reviewed"],
      "properties": {
        "description": { "type": "string" },
        "source_notes": { "type": "string" },
        "rules_baseline": { "type": "string" },
        "last_reviewed": { "type": "string", "format": "date" },
        "verification_status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/keyword" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "keyword": {
      "type": "object",
      "required": ["id", "name", "type", "parameterized", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "kebab-case unique identifier"
        },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["unit", "weapon", "upgrade"]
        },
        "parameterized": {
          "type": "boolean",
          "description": "true if the keyword takes an X value"
        },
        "stacks": {
          "type": ["boolean", "null"],
          "description": "whether multiple instances add together; null if unknown/not applicable"
        },
        "description": { "type": "string", "minLength": 1 },
        "rules_note": { "type": "string" },
        "verified": {
          "type": "boolean",
          "description": "has this entry been cross-checked against a current official/authoritative source"
        },
        "verification_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
