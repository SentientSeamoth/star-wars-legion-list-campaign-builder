{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legion-app.local/schema/upgrade.schema.json",
  "title": "Legion Upgrade Card Library",
  "type": "object",
  "required": ["_meta", "upgrades"],
  "properties": {
    "_meta": { "type": "object" },
    "upgrades": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/upgrade" }
    }
  },
  "definitions": {
    "upgrade": {
      "type": "object",
      "required": [
        "id", "name", "category", "unique_card", "restriction",
        "roster_verified"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "armament", "command", "comms", "crew", "force", "gear",
            "generator", "grenades", "hardpoint", "heavy-weapon",
            "ordnance", "personnel", "programming", "pilot", "training",
            "doctrine"
          ],
          "description": "'doctrine' is a newer card sub-type introduced with the customizable Jedi General/Knight kit (Sept 2025) -- confirm it isn't better modeled as a Training subtype before relying on it."
        },
        "unique_card": {
          "type": "boolean",
          "description": "true if this is a one-per-army unique-named upgrade (e.g. tied to a specific character), false for generic reusable cards."
        },
        "restriction": {
          "type": "string",
          "enum": ["generic", "faction", "character", "affiliation", "battle-force"],
          "description": "generic = any unit with the matching upgrade-bar icon; faction/character/affiliation/battle-force = restricted to that scope, see restricted_to."
        },
        "restricted_to": {
          "type": ["string", "array", "null"],
          "description": "faction id, unit id, affiliation id, or battle force name this card is restricted to, if restriction != generic."
        },
        "points": { "type": ["integer", "null"] },
        "points_verified": { "type": "boolean" },
        "effect_description": { "type": ["string", "null"] },
        "effect_verified": { "type": "boolean" },
        "keywords_granted": { "type": ["array", "null"] },
        "weapon_profile": { "type": ["object", "null"] },
        "source": { "type": ["string", "null"] },
        "roster_verified": { "type": "boolean" },
        "roster_source": { "type": "string" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
